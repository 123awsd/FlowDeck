# Keep both keys here, then switch providers by changing only AI_PROVIDER.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Optional provider-specific overrides. QWEN_BASE_URL may be a DashScope
# compatible-mode /v1 base URL or the full /chat/completions endpoint.
